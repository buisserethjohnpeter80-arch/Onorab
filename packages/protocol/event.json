{"$id":"https://potoriktrack.com/onorab/protocol/event.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"WebSocket /events message. `type` is the event name; `transfer` is present for transfer events.","properties":{"file":{"$ref":"file.json"},"message":{"type":"string"},"timestamp":{"format":"date-time","type":"string"},"transfer":{"$ref":"transfer.json"},"type":{"enum":["file.added","transfer.started","transfer.progress","transfer.completed","transfer.failed","hub.connected","hub.disconnected"],"type":"string"}},"required":["type","timestamp"],"title":"OnorabEvent","type":"object"}