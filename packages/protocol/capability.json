{"$id":"https://potoriktrack.com/onorab/protocol/capability.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Future connectors (FL Studio, Logic Pro, Blender, Photoshop, Premiere Pro, Maya, ...) declare what they can do. Phase 1 only implements the audio connector; other entries are declarations, not working code.","properties":{"capabilities":{"items":{"enum":["capture_audio","import_audio","export_audio","import_file","export_file","preview"],"type":"string"},"type":"array"},"connectorId":{"examples":["fl-studio","logic-pro","blender"],"type":"string"},"displayName":{"type":"string"},"kind":{"enum":["audio","video","image","3d","document"],"type":"string"}},"required":["connectorId","displayName","kind","capabilities"],"title":"ConnectorCapability","type":"object"}