# Onorab local configuration — copy to .env and fill in your own values.
# This file itself contains NO secrets. Never put a client secret, access
# token, or refresh token here. Phase 2 reads the OAuth JSON from the
# path in ONORAB_CREDENTIALS_PATH only.

# Hub (localhost only)
ONORAB_HUB_PORT=18741
ONORAB_HUB_URL=http://127.0.0.1:18741

# Drive provider: Phase 1 supports "mock" ONLY. Any other value makes
# the Hub fail fast at startup instead of silently using mock data.
ONORAB_DRIVE_PROVIDER=mock

# Local audio cache (audio bytes only, never tokens)
# Windows default when unset: %LOCALAPPDATA%\Onorab\cache
ONORAB_CACHE_DIR=

# Phase 2 ONLY: local path to your Desktop OAuth JSON (Google Cloud
# Console > Desktop app). The file itself is gitignored and never
# compiled into any binary.
ONORAB_CREDENTIALS_PATH=
